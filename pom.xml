<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.upbox</groupId>
    <artifactId>upbox-sistema</artifactId>
    <version>1.0.0</version>
    <name>upbox-sistema</name>
    <description>UpBox - sistema de gerenciamento de estoque (TCC)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Mesmo Hibernate gerenciado pelo Spring Boot; SQL legado sem trocar o framework. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <!-- Segurança de formulário e validações no servidor. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.thymeleaf.extras</groupId><artifactId>thymeleaf-extras-springsecurity6</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
        <!-- Spring Web: controllers e servidor embutido. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf: paginas HTML no servidor. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- JPA: salva as classes @Entity no banco. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver: permite ao Java conversar com o PostgreSQL. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testes com JUnit, Spring e MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 existe SOMENTE nos testes, nunca como banco da aplicacao. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Usa PostgreSQL instalado, sem exigir Docker no computador dos alunos. -->
        <profile>
            <id>postgres-it</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Impede distribuir sem querer uma senha preenchida no computador. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions><execution><id>conferir-configuracao-distribuivel</id>
                    <phase>prepare-package</phase><goals><goal>run</goal></goals>
                    <configuration><target>
                        <loadfile property="upbox.config.conteudo" srcFile="${project.basedir}/src/main/resources/application.properties" encoding="UTF-8"/>
                        <condition property="upbox.config.tem-senha"><not>
                            <matches string="${upbox.config.conteudo}" pattern="(?m)^spring[.]datasource[.]password=[$][{]DB_PASSWORD:[}]\r?$"/>
                        </not></condition>
                        <fail if="upbox.config.tem-senha" message="Pacote bloqueado: deixe a senha vazia no padrao do fonte. Preencha somente o application.properties externo do computador de uso."/>
                        <condition property="upbox.config.tem-bootstrap"><matches string="${upbox.config.conteudo}" pattern="(?m)^\s*upbox[.]admin-inicial[.]senha\s*=\s*\S+"/></condition>
                        <fail if="upbox.config.tem-bootstrap" message="Pacote bloqueado: remova a senha de administrador inicial do arquivo distribuível."/>
                    </target></configuration>
                </execution></executions>
            </plugin>
            <!-- ZIP convencional: JAR executável, configuração, script e instruções. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration><descriptors><descriptor>src/assembly/escola.xml</descriptor></descriptors></configuration>
                <executions><execution><id>pacote-escola</id><phase>package</phase>
                    <goals><goal>single</goal></goals>
                </execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
